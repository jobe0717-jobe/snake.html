<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <!-- 確保在行動裝置上有良好的縮放表現 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>銀河孤寂｜極簡貪食蛇</title>
    <style>
        /* 清除瀏覽器預設的邊距，並隱藏捲軸以達極致高冷感 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'PingFang TC', 'Microsoft JhengHei', sans-serif;
            user-select: none; /* 防止玩家因雙擊畫面選取到文字 */
        }

        /* 滿版網頁設定，使用深邃星空藍黑色作為底色 */
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #05050a;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* 背景的 Canvas，用於繪製銀河星空動畫 */
        #galaxyCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1; /* 置於底層 */
        }

        /* 遊戲主要容器：採用玻璃擬態風格（半透明、毛玻璃與細邊框） */
        .game-container {
            position: relative;
            z-index: 10; /* 置於銀河背景之上 */
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px;
            background: rgba(255, 255, 255, 0.03); /* 極低的透明白，營造高冷感 */
            backdrop-filter: blur(12px); /* 現代感毛玻璃特效 */
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08); /* 隱約可見的白色細邊框 */
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5); /* 深沉的陰影 */
        }

        /* 標題與分數欄位的排版 */
        .header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            color: #e0e6ed; /* 帶有一點點藍的冷白色 */
        }

        /* 遊戲標題：帶有微弱的冰藍色霓虹光暈 */
        h1 {
            font-size: 20px;
            font-weight: 300; /* 細體字，展現極簡高冷 */
            letter-spacing: 4px; /* 字距拉開，增加空間感 */
            text-shadow: 0 0 10px rgba(0, 229, 255, 0.3);
        }

        /* 分數顯示區塊 */
        .score-board {
            font-size: 14px;
            font-weight: 400;
            letter-spacing: 1px;
            color: #8fa0b5; /* 冷灰色 */
        }

        /* 強調分數的數字 */
        #score {
            font-weight: 600;
            color: #00e5ff; /* 亮眼的電光青色 */
        }

        /* 遊戲畫面的 Canvas */
        #gameCanvas {
            background: rgba(10, 15, 28, 0.6); /* 遊戲畫布本身的深藍黑底色 */
            border: 1px solid rgba(0, 229, 255, 0.15); /* 微弱的青色邊框 */
            border-radius: 8px;
            box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.6);
        }

        /* 遊戲結束或準備開始時的覆蓋遮罩 */
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(5, 5, 10, 0.85); /* 半透明黑遮罩 */
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 20; /* 覆蓋在遊戲畫面最上方 */
            transition: opacity 0.5s ease;
        }

        /* 遮罩內的文字提示 */
        .overlay-text {
            color: #ffffff;
            font-size: 24px;
            font-weight: 300;
            letter-spacing: 6px;
            margin-bottom: 25px;
            text-align: center;
        }

        /* 遮罩內的次要提示文字（如分數） */
        .overlay-subtext {
            color: #8fa0b5;
            font-size: 14px;
            margin-bottom: 30px;
            letter-spacing: 1px;
        }

        /* 經典高冷極簡按鈕 */
        .btn {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #ffffff;
            padding: 12px 35px;
            font-size: 13px;
            letter-spacing: 3px;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.3s ease;
            outline: none;
        }

        /* 按鈕懸停效果：邊框變亮、背景微白、發出青光 */
        .btn:hover {
            border-color: #00e5ff;
            background: rgba(255, 255, 255, 0.05);
            box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);
        }

        /* 用於控制遮罩隱藏的類別 */
        .hidden {
            opacity: 0;
            pointer-events: none;
        }
    </style>
</head>
<body>

    <!-- 銀河動畫 Canvas 背景 -->
    <canvas id="galaxyCanvas"></canvas>

    <!-- 遊戲主體面板 -->
    <div class="game-container">
        
        <!-- 上方資訊欄 -->
        <div class="header">
            <h1>NEBULA</h1>
            <div class="score-board">SCORE: <span id="score">0</span></div>
        </div>

        <!-- 遊戲主體 Canvas 畫面 -->
        <canvas id="gameCanvas" width="400" height="400"></canvas>

        <!-- 遊戲開始/結束的互動遮罩 -->
        <div id="overlay" class="overlay">
            <div id="overlayTitle" class="overlay-text">SILENT GALAXY</div>
            <div id="overlaySub" class="overlay-subtext">使用方向鍵或 WASD 來引導</div>
            <button id="startBtn" class="btn">ENTER</button>
        </div>
        
    </div>

    <script>
        // ==========================================
        // 1. 銀河背景動畫系統 (Galaxy Background)
        // ==========================================

        const galCanvas = document.getElementById('galaxyCanvas'); // 獲取銀河畫布
        const galCtx = galCanvas.getContext('2d'); // 獲取銀河繪圖上下文
        let stars = []; // 用於存放所有星星粒子的陣列
        const numStars = 150; // 星星的總數量

        // 調整銀河畫布大小，使其完美填滿瀏覽器視窗
        function resizeGalaxy() {
            galCanvas.width = window.innerWidth;
            galCanvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeGalaxy);
        resizeGalaxy(); // 初始化執行

        // 建立單個星星粒子的類別
        class Star {
            constructor() {
                this.reset();
            }
            // 隨機重設星星的位置與屬性
            reset() {
                this.x = Math.random() * galCanvas.width; // 隨機 X 座標
                this.y = Math.random() * galCanvas.height; // 隨機 Y 座標
                this.size = Math.random() * 1.5; // 星星大小 (0 ~ 1.5 像素)
                this.speedX = (Math.random() - 0.5) * 0.1; // 極慢的 X 軸漂移速度
                this.speedY = (Math.random() - 0.5) * 0.1; // 極慢的 Y 軸漂移速度
                this.alpha = Math.random(); // 隨機初始透明度
                this.fadeSpeed = Math.random() * 0.005 + 0.002; // 呼吸燈般的閃爍速度
            }
            // 更新星星的狀態
            update() {
                this.x += this.speedX; // 位置微調 X
                this.y += this.speedY; // 位置微調 Y
                this.alpha += this.fadeSpeed; // 改變透明度實現閃爍

                // 當透明度超過上限或下限時，反轉閃爍方向
                if (this.alpha > 1 || this.alpha < 0) {
                    this.fadeSpeed = -this.fadeSpeed;
                }

                // 如果星星飄出螢幕外，則重新在螢幕內隨機生成
                if (this.x < 0 || this.x > galCanvas.width || this.y < 0 || this.y > galCanvas.height) {
                    this.reset();
                }
            }
            // 繪製星星到畫布上
            draw() {
                galCtx.fillStyle = `rgba(224, 230, 237, ${Math.max(0, Math.min(1, this.alpha))})`; // 冷白偏藍色
                galCtx.beginPath();
                galCtx.arc(this.x, this.y, this.size, 0, Math.PI * 2); // 畫圓形粒子
                galCtx.fill();
            }
        }

        // 初始化所有星星
        for (let i = 0; i < numStars; i++) {
            stars.push(new Star());
        }

        // 銀河背景的動畫循環主圈
        function animateGalaxy() {
            // 每幀使用帶有一點透明度的黑底覆蓋，可以做出淡淡的粒子拖尾效果（不過這裡主要維持清澈感）
            galCtx.fillStyle = '#05050a';
            galCtx.fillRect(0, 0, galCanvas.width, galCanvas.height);

            // 更新並繪製每一顆星星
            stars.forEach(star => {
                star.update();
                star.draw();
            });

            // 循環調用下一幀
            requestAnimationFrame(animateGalaxy);
        }
        animateGalaxy(); // 啟動銀河背景動畫


        // ==========================================
        // 2. 貪食蛇核心遊戲邏輯 (Snake Game Engine)
        // ==========================================

        const canvas = document.getElementById('gameCanvas'); // 獲取遊戲畫布
        const ctx = canvas.getContext('2d'); // 獲取遊戲繪圖上下文
        const scoreDisplay = document.getElementById('score'); // 分數文字節點
        const overlay = document.getElementById('overlay'); // 互動遮罩
        const overlayTitle = document.getElementById('overlayTitle'); // 遮罩大標題
        const overlaySub = document.getElementById('overlaySub'); // 遮罩副標題
        const startBtn = document.getElementById('startBtn'); // 開始按鈕

        // 遊戲網格規格設定
        const gridSize = 20; // 每個格子的大小是 20x20 像素
        const tileCount = canvas.width / gridSize; // 橫豎各有 20 個格子 (400/20)

        // 遊戲變數定義
        let snake = []; // 貪食蛇身體座標陣列
        let food = { x: 0, y: 0 }; // 食物座標物件
        let dx = gridSize; // X 軸移動增量（預設向右移動一格）
        let dy = 0; // Y 軸移動增量
        let score = 0; // 當前得分
        let gameInterval; // 存放遊戲循環計時器 (setInterval)
        let isGameRunning = false; // 遊戲是否正在進行中
        let changingDirection = false; // 防抖旗標，防止在單一幀內快速按下兩個方向鍵導致自撞

        // 監聽鍵盤事件
        document.addEventListener('keydown', changeDirection);
        // 監聽點擊按鈕事件以開始遊戲
        startBtn.addEventListener('click', startGame);

        // 初始化或重置遊戲狀態
        function initGame() {
            // 蛇的初始身體（三格長，位於畫面中間偏左）
            snake = [
                { x: gridSize * 5, y: gridSize * 10 },
                { x: gridSize * 4, y: gridSize * 10 },
                { x: gridSize * 3, y: gridSize * 10 }
            ];
            score = 0; // 得分歸零
            scoreDisplay.textContent = score; // 更新網頁分數
            dx = gridSize; // 恢復向右移動
            dy = 0;
            generateFood(); // 隨機生成第一個食物
        }

        // 開始遊戲
        function startGame() {
            overlay.classList.add('hidden'); // 隱藏黑遮罩
            initGame(); // 重設數據
            isGameRunning = true;
